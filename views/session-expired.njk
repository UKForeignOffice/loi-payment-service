{% extends "layouts/template.njk" %}

{% block pageTitle %}Session expired - Get a document legalised – GOV.UK {% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">
      <h1 class="govuk-heading-l">Your application has timed out</h1>
      <p class="govuk-body">You haven't entered any details for 30 minutes, so we've cleared your information to keep it secure.</p>
      <ul class="govuk-list govuk-list--bullet">
        <li><a class="govuk-link" href="{{ startNewApplicationUrl }}">Start a new application</a></li>
        <li><a class="govuk-link" href="https://www.gov.uk">GOV.UK home page</a></li>
      </ul>
    </div>
  </div>
{% endblock %}
