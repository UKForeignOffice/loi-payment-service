
<%- include ('partials/header') %>

<div class="govuk-width-container govuk-!-margin-top-6">

    <% if (loggedIn == true) { %>
        <div class="inner_header">
            <% if (user_data.loggedIn) { %>
                <div class="inner-header-content">
                    <span class="email-logout-text">
                        <% if (typeof(user_data.account)!='undefined' && user_data.account!=null && user_data.account.first_name != null) { %>
                            <%= (user_data.account.first_name+' '+user_data.account.last_name).substr(0,50) %>
                        <% } else { %>
                            <%= user_data.user.email %>
                        <% } %>
                    </span>
                    <span class="email-logout-text">
                        <a href="/dashboard" class="govuk-link">Applications</a>
                        <a href="<%= user_data.url%>/account" class="govuk-link">Account</a>
                        <a href="<%= user_data.url%>/addresses" class="govuk-link">Addresses</a>
                        <a href="/sign-out" id="sign-out-link" class="govuk-link">Sign out</a>
                    </span>
                </div>
            <% } %>
        </div>
    <% } %>

    <% if (isSessionValid == false) { %>
        <title>Your payment was unsuccessful - Get a document legalised – GOV.UK</title>
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <h1 class="govuk-heading-l">Sorry, you'll have to start again</h1>
                <p class="govuk-body">You took longer than 25 minutes to enter your payment details and we've cleared your information to keep it secure. Your application has not been submitted and payment has not been taken.</p>
                <ul class="govuk-list govuk-list--bullet">
                    <li><a class="govuk-link" href="/api/user/sign-in">Sign in</a></li>
                    <li><a class="govuk-link" href="/start">Start a new application</a></li>
                    <li><a class="govuk-link" href="https://www.gov.uk">GOV.UK home page</a></li>
                </ul>
            </div>
        </div>
    <% } else { %>
        <title>Your payment was unsuccessful - Get a document legalised – GOV.UK</title>
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <h1 class="govuk-heading-l">Your payment was unsuccessful</h1>
                <p class="govuk-body">We were unable to take payment on the card you entered. Check your card details, make sure you have enough funds on the card to pay for your documents, or use a different card.</p>
                <p class="govuk-body">Please try again.</p>

                <!-- PAYMENT FORM -->
                <form action="<%= next_url %>" onsubmit="disablePaymentButton();">
                    <div class="govuk-form-group">
                        <button id="paymentButton" role="button" draggable="false" class="govuk-button" data-module="govuk-button" type="submit">Continue to payment</button>
                    </div>
                </form>
            </div>
        </div>
    <% } %>

</div>

<%- include ('partials/footer') %>
