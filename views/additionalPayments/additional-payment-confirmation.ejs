<%- include ('../partials/header') %>

<div class="govuk-width-container govuk-!-margin-top-6">
    <% if (isSessionValid == false) { %>
        <title>Your payment was unsuccessful - Get a document legalised – GOV.UK</title>
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <h1 class="govuk-heading-l">Sorry, you'll have to start again</h1>
                <p class="govuk-body">You took longer than 25 minutes to enter your payment details and we've cleared your information to keep it secure. Your application has not been submitted and payment has not been taken.</p>
                <ul class="govuk-list govuk-list--bullet">
                    <li><a class="govuk-link" href="/start">Start a new application</a></li>
                    <li><a class="govuk-link" href="https://www.gov.uk">GOV.UK home page</a></li>
                </ul>
            </div>
        </div>
    <% } else { %>

        <% if (paymentSuccessful == true) { %>
            <title>Your payment was successful - Get a document legalised – GOV.UK</title>
            <div class="govuk-grid-row">

                <div class="govuk-panel govuk-panel--confirmation">
                    <h1 class="govuk-panel__title">Payment complete</h1>
                    <div class="govuk-panel__body">
                        Your FCDO reference number
                        <br>
                        <strong><%= appReference %></strong>
                    </div>
                </div>

                <div class="govuk-grid-column-two-thirds">
                    <p class="govuk-body">Thank you for your order from the Foreign, Commonwealth & Development Office. We've taken payment for the following:</p>

                    <table id="review-personal-details" class="printable-summary">
                        <tbody>
                        <tr>
                            <td class="summary-table-cell-label summary-label">Amount</td>
                            <td id="summary-name" class="summary-table-cell-content"><span>£<%= cost %></span></td>
                        </tr>
                        <tr>
                            <td class="summary-table-cell-label summary-label">Card type</td>
                            <td id="summary-name" class="summary-table-cell-content"><span><%= paymentMethod %></span></td>
                        </tr>
                        <tr>
                            <td class="summary-table-cell-label summary-label">Date</td>
                            <td id="summary-name" class="summary-table-cell-content"><span><%= createdDate %></span></td>
                        </tr>
                        <tr>
                            <td class="summary-table-cell-label summary-label">Payment Reference</td>
                            <td id="summary-name" class="summary-table-cell-content"><span><%= appReference %></span></td>
                        </tr>
                        </tbody>
                    </table>

                    <p class="govuk-body">We've emailed a confirmation to <strong><%= email %></strong>. If you don't receive the email please check your spam folder.</p>

                    <h2 class="govuk-heading-l nomargintop">What to do next</h2>
                    <p class="govuk-body">Your payment has been successfully submitted and the Legalisation Office has been notified. No further action is required.</p>
                    <p class="govuk-body"><a class="govuk-link" href="<%= startNewApplicationUrl %>">Make another payment</a></p>
                </div>
            </div>

            <% req.session.destroy(); %>
        <% } else { %>
            <title>Your payment was unsuccessful - Get a document legalised – GOV.UK</title>
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds">
                    <h1 class="govuk-heading-l">Your payment was unsuccessful</h1>
                    <p class="govuk-body">We were unable to take payment on the card you entered. Check your card details, make sure you have enough funds on the card, or use a different card.</p>
                    <p class="govuk-body">Please try again.</p>

                    <!-- PAYMENT FORM -->
                    <form action="<%= next_url %>" onsubmit="disablePaymentButton();">
                        <button id="paymentButton" role="button" draggable="false" class="govuk-button" data-module="govuk-button" type="submit">Continue to payment</button>
                    </form>
                </div>
            </div>
        <% } %>

    <% } %>
</div>

<%- include ('../partials/footer') %>
