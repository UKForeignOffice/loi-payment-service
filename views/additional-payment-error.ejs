
<%- include ('partials/header') %>

<div class="govuk-width-container govuk-!-margin-top-6">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">Sorry, there is a problem with the service</h1>
            <p class="govuk-body">Please try again later.</p>
            <p class="govuk-body">Error: <%= errorMessage %></p>
            <a href="<%= startNewApplicationUrl %>" id="start" role="button" class="govuk-button" data-module="govuk-button">Start again</a>
        </div>
    </div>
</div>

<%- include ('partials/footer') %>
