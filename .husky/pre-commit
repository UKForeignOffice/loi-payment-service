#!/usr/bin/env sh
NODE_MAJOR=$(node --version 2>/dev/null | sed -n 's/^v\([0-9][0-9]*\)\..*$/\1/p')

if [ "$NODE_MAJOR" != "24" ]; then
  NVM_SH="${NVM_DIR:-$HOME/.nvm}/nvm.sh"
  if [ -s "$NVM_SH" ]; then
    . "$NVM_SH" >/dev/null
    if [ "$?" -eq 0 ]; then
      if nvm use --silent 24 >/dev/null; then
        PATH="$NVM_BIN:$PATH"
        export PATH
        hash -r 2>/dev/null || true
      fi
    fi
  fi
  NODE_MAJOR=$(node --version 2>/dev/null | sed -n 's/^v\([0-9][0-9]*\)\..*$/\1/p')
fi

if [ "$NODE_MAJOR" != "24" ]; then
  echo "❌ Commit rejected: Node.js 24 could not be activated (found ${NODE_MAJOR:-no usable Node.js}). Install Node.js 24 through NVM or make it available to SourceTree." >&2
  exit 1
fi

npm audit fix || true

if ! npm audit --audit-level=high; then
  echo "❌ Unresolved high/critical vulnerabilities remain. Fix or explicitly override with --force before committing." >&2
  exit 1
fi

git add package-lock.json 2>/dev/null || true
